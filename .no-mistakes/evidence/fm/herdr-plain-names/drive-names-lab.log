
== lab settings (docs/herdr-config.toml, key command re-pointed at the lab)
# Herdr sidebar settings for Mission Control's plain names.
# Add these lines to ~/.config/herdr/config.toml, run `herdr config check`,
# then reload with Ctrl+B then Shift+R (or restart Herdr).
# docs/mission-control.md ("Plain names in Herdr") explains what they show;
# bin/fm_herdr_names.py sets the `$name`, `$who` and `$job` display values.
# Deleting these lines restores Herdr's default sidebar.

[ui]
# Hide the tab strip in a space that has only one tab open.
hide_tab_bar_when_single_tab = true
# Keep agents grouped under their space (Herdr's default, written down).
agent_panel_sort = "spaces"

[ui.sidebar.spaces]
# One line per space: its plain name.
rows = [["state_icon", "$name"]]

[ui.sidebar.agents]
# Line 1: who it is. Line 2, dimmed: what it is working on.
rows = [["state_icon", "$who"], [{ token = "$job", dim = true }]]

# Ctrl+B then Alt+N puts the plain names back by hand, for example right after
# Herdr restarts and before Mission Control is running again.
# Change both paths if your firstmate home or repository lives elsewhere.
[[keys.command]]
key = "prefix+alt+n"
type = "shell"
command = "FM_HOME=/private/var/folders/jb/yb1cpv3d0vsb1gcnh_v_ds880000gn/T/fm-mc-drive.z5T1ue/benjie-agent-workspace FM_MC_HERDR='/Users/benjie/.no-mistakes/worktrees/40995176e50b/01M3HK9SNT7ERFD45Q1T5RDE34/bin/fm-herdr-lab.sh run fm-lab-mc-drive-72296-10464' /Users/benjie/.no-mistakes/worktrees/40995176e50b/01M3HK9SNT7ERFD45Q1T5RDE34/bin/fm-mission-control.sh names > /private/var/folders/jb/yb1cpv3d0vsb1gcnh_v_ds880000gn/T/fm-mc-drive.z5T1ue/key.log 2>&1"
config: ok
